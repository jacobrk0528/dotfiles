{
  "manifest_version": 3,
  "name": "Chat Export",
  "version": "0.1.0",
  "description": "One-click copy of ChatGPT, Claude, Gemini and Grok conversations as JSON.",
  "permissions": ["offscreen", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copy conversation as JSON",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy conversation as JSON"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/util.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/gemini.js",
        "content/adapters/grok.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
