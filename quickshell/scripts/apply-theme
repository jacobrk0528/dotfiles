#!/usr/bin/env python3
"""Propagate theme.json to every app that can't read it directly.

quickshell reads theme.json live; this script generates the include files for
hyprland, hyprlock and ghostty so one palette drives the whole desktop.

Run after editing theme.json:  quickshell/scripts/apply-theme
"""

import argparse
import json
import os
import subprocess
import sys

DOTS = os.path.expanduser("~/dotfiles")
THEME = os.path.join(DOTS, "quickshell", "theme.json")

BANNER = "# Generated by quickshell/scripts/apply-theme — edit theme.json instead.\n"


def hex_to_rgba(color, alpha=1.0):
    """#rrggbb -> hyprland rgba(rrggbbaa)."""
    c = color.lstrip("#")
    return f"rgba({c}{int(round(alpha * 255)):02x})"


def rgb(color):
    """#rrggbb -> "r,g,b", the form KConfig colour keys take."""
    c = color.lstrip("#")
    return ",".join(str(int(c[i:i + 2], 16)) for i in (0, 2, 4))


def mix(a, b, ratio):
    """Blend two "r,g,b" strings; ratio is how much of b to take."""
    ca = [int(v) for v in a.split(",")]
    cb = [int(v) for v in b.split(",")]
    return ",".join(str(int(round(x + (y - x) * ratio))) for x, y in zip(ca, cb))


def write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    previous = None
    if os.path.exists(path):
        with open(path) as f:
            previous = f.read()
    if previous == content:
        return False
    with open(path, "w") as f:
        f.write(content)
    return True


def hyprland(t):
    """Window borders and shadows."""
    return BANNER + f"""
general {{
    col.active_border = {hex_to_rgba(t["accent"], 0.55)}
    col.inactive_border = {hex_to_rgba(t["text"], 0.10)}
}}

decoration {{
    shadow {{
        color = {hex_to_rgba("#000000", 0.4)}
    }}
}}
"""


def hyprlock(t):
    """Colours only; layout stays in hyprlock.conf."""
    return BANNER + f"""
$base = {hex_to_rgba(t["base"], 1.0)}
$surface = {hex_to_rgba(t["base"], 0.75)}
$border = {hex_to_rgba(t["text"], 0.08)}
$text = {hex_to_rgba(t["text"], 0.9)}
$accent = {hex_to_rgba(t["accent"], 0.8)}
$ok = {hex_to_rgba(t["green"], 0.8)}
$err = {hex_to_rgba(t["red"], 0.8)}
"""


def hyprland_lua(t):
    """Same palette for the Lua config, which cannot source a .conf file."""
    return BANNER.replace("#", "--") + f"""
return {{
    active_border   = "{hex_to_rgba(t["accent"], 0.55)}",
    inactive_border = "{hex_to_rgba(t["text"], 0.10)}",
    shadow          = "{hex_to_rgba("#000000", 0.4)}",
}}
"""


def kdeglobals(t):
    """KDE colour scheme so Dolphin and friends match the shell.

    Written into kdeglobals directly rather than shipped as a .colors scheme:
    with no Plasma session running there is nothing to apply a scheme file,
    so the colours have to live where KConfig reads them.
    """
    base = rgb(t["base"])
    surface = rgb(t["surface"])
    accent = rgb(t["accent"])
    text = rgb(t["text"])
    dim = mix(text, base, 0.45)

    def block(name, bg, fg, extra=""):
        return f"""[Colors:{name}]
BackgroundNormal={bg}
BackgroundAlternate={mix(bg, text, 0.04)}
ForegroundNormal={fg}
ForegroundInactive={dim}
ForegroundActive={accent}
ForegroundLink={accent}
DecorationFocus={accent}
DecorationHover={accent}
{extra}"""

    return BANNER + f"""
[General]
ColorScheme=SlateFrost
Name=Slate & Frost
XftAntialias=true
XftHintStyle=hintslight
XftSubPixel=rgb
font=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
fixed=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
menuFont=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
smallestReadableFont=JetBrainsMono Nerd Font,8,-1,5,50,0,0,0,0,0
toolBarFont=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0

[KDE]
SingleClick=false
AnimationDurationFactor=0.5
widgetStyle=Breeze

[Icons]
Theme=breeze-dark

{block("Window", base, text)}
{block("View", mix(base, "0,0,0", 0.25), text)}
{block("Button", surface, text)}
{block("Selection", accent, base, f"ForegroundNormal={base}\nForegroundInactive={base}")}
{block("Tooltip", surface, text)}
{block("Complementary", base, text)}
{block("Header", base, text)}

[WM]
activeBackground={base}
activeForeground={text}
inactiveBackground={base}
inactiveForeground={dim}
"""


def greeter_palette(t):
    """Palette singleton for the greetd greeter.

    The greeter runs as the `greeter` user out of /etc/greetd, where nothing
    under /home is readable, so it cannot import the shell's Theme singleton
    or read theme.json at runtime. Baking the palette in here keeps one source
    of truth without granting the greeter user any access to the home dir.
    """

    def rgba(color, a):
        c = color.lstrip("#")
        r, g, b = (int(c[i:i + 2], 16) / 255 for i in (0, 2, 4))
        return f"Qt.rgba({r:.4f}, {g:.4f}, {b:.4f}, {a})"

    return BANNER.replace("#", "//") + f"""pragma Singleton
import QtQuick

QtObject {{
    readonly property color base: "{t["base"]}"
    readonly property color accent: {rgba(t["accent"], 0.85)}
    readonly property color red: {rgba(t["red"], 0.85)}
    readonly property color green: {rgba(t["green"], 0.85)}
    readonly property color gray: "{t["gray"]}"

    readonly property color cardBg: {rgba(t["base"], 0.75)}
    readonly property color fieldBg: {rgba("#000000", 0.35)}
    readonly property color border: {rgba(t["text"], 0.08)}

    readonly property color textPrimary: {rgba(t["text"], 0.9)}
    readonly property color textSecondary: {rgba(t["text"], 0.6)}
    readonly property color textDim: {rgba(t["text"], 0.35)}

    readonly property string fontFamily: "{t["font"]}"
    readonly property int panelRadius: {t["panelRadius"] + 4}

    readonly property int durFast: 150
    readonly property int durMed: 200
    readonly property int durSlow: 320
    readonly property int easing: Easing.OutCubic

    function alpha(c, a) {{
        return Qt.rgba(c.r, c.g, c.b, a);
    }}
}}
"""


def ghostty(t):
    """Terminal palette derived from the shell colours."""
    return BANNER + f"""
background = {t["base"]}
foreground = {t["text"]}
selection-background = {t["surface"]}
selection-foreground = {t["text"]}
cursor-color = {t["accent"]}

palette = 0={t["base"]}
palette = 1={t["red"]}
palette = 2={t["green"]}
palette = 3={t["yellow"]}
palette = 4={t["accent"]}
palette = 5={t["pink"]}
palette = 6={t["accent"]}
palette = 7={t["text"]}
palette = 8={t["gray"]}
palette = 9={t["red"]}
palette = 10={t["green"]}
palette = 11={t["yellow"]}
palette = 12={t["accent"]}
palette = 13={t["purple"]}
palette = 14={t["accent"]}
palette = 15={t["text"]}
"""


def yazi(t):
    """Yazi's theme.toml.

    Only the colour-bearing keys are written; icons, filetype globs and the
    dark/light split come from Yazi's shipped preset, which this merges over.
    """
    dim = "#" + "".join(f"{v:02x}" for v in
                        [int(c) for c in mix(rgb(t["text"]), rgb(t["base"]), 0.45).split(",")])

    return BANNER + f"""
[mgr]
cwd = {{ fg = "{t["accent"]}" }}

find_keyword  = {{ fg = "{t["yellow"]}", bold = true, italic = true, underline = true }}
find_position = {{ fg = "{t["pink"]}", bg = "reset", bold = true, italic = true }}

symlink_target = {{ fg = "{t["gray"]}", italic = true }}

marker_copied   = {{ fg = "{t["green"]}",  bg = "{t["green"]}" }}
marker_cut      = {{ fg = "{t["red"]}",    bg = "{t["red"]}" }}
marker_marked   = {{ fg = "{t["accent"]}", bg = "{t["accent"]}" }}
marker_selected = {{ fg = "{t["yellow"]}", bg = "{t["yellow"]}" }}

count_copied   = {{ fg = "{t["base"]}", bg = "{t["green"]}" }}
count_cut      = {{ fg = "{t["base"]}", bg = "{t["red"]}" }}
count_selected = {{ fg = "{t["base"]}", bg = "{t["yellow"]}" }}

border_symbol = "│"
border_style  = {{ fg = "{t["surface"]}" }}

[tabs]
active   = {{ fg = "{t["base"]}", bg = "{t["accent"]}", bold = true }}
inactive = {{ fg = "{t["gray"]}", bg = "{t["surface"]}" }}

[mode]
normal_main = {{ fg = "{t["base"]}", bg = "{t["accent"]}", bold = true }}
normal_alt  = {{ fg = "{t["accent"]}", bg = "{t["surface"]}" }}
select_main = {{ fg = "{t["base"]}", bg = "{t["green"]}", bold = true }}
select_alt  = {{ fg = "{t["green"]}", bg = "{t["surface"]}" }}
unset_main  = {{ fg = "{t["base"]}", bg = "{t["orange"]}", bold = true }}
unset_alt   = {{ fg = "{t["orange"]}", bg = "{t["surface"]}" }}

[status]
perm_sep   = {{ fg = "{dim}" }}
perm_type  = {{ fg = "{t["green"]}" }}
perm_read  = {{ fg = "{t["yellow"]}" }}
perm_write = {{ fg = "{t["red"]}" }}
perm_exec  = {{ fg = "{t["accent"]}" }}

progress_label  = {{ fg = "{t["text"]}", bold = true }}
progress_normal = {{ fg = "{t["accent"]}", bg = "{t["surface"]}" }}
progress_error  = {{ fg = "{t["red"]}", bg = "{t["surface"]}" }}

[which]
border          = {{ fg = "{t["accent"]}" }}
cand            = {{ fg = "{t["accent"]}" }}
rest            = {{ fg = "{dim}" }}
desc            = {{ fg = "{t["purple"]}" }}
separator_style = {{ fg = "{dim}" }}

[confirm]
border  = {{ fg = "{t["accent"]}" }}
title   = {{ fg = "{t["accent"]}" }}
btn_yes = {{ fg = "{t["base"]}", bg = "{t["accent"]}" }}
btn_no  = {{ fg = "{t["gray"]}" }}

[spot]
border   = {{ fg = "{t["accent"]}" }}
title    = {{ fg = "{t["accent"]}" }}
tbl_col  = {{ fg = "{t["accent"]}" }}
tbl_cell = {{ fg = "{t["base"]}", bg = "{t["yellow"]}" }}

[notify]
title_info  = {{ fg = "{t["green"]}" }}
title_warn  = {{ fg = "{t["yellow"]}" }}
title_error = {{ fg = "{t["red"]}" }}

[pick]
border   = {{ fg = "{t["accent"]}" }}
active   = {{ fg = "{t["pink"]}", bold = true }}
inactive = {{ fg = "{t["gray"]}" }}

[input]
border   = {{ fg = "{t["accent"]}" }}
title    = {{ fg = "{t["text"]}" }}
value    = {{ fg = "{t["text"]}" }}
selected = {{ fg = "{t["base"]}", bg = "{t["accent"]}" }}

[cmp]
border   = {{ fg = "{t["accent"]}" }}
active   = {{ fg = "{t["base"]}", bg = "{t["accent"]}" }}
inactive = {{ fg = "{t["gray"]}" }}

[tasks]
border  = {{ fg = "{t["accent"]}" }}
title   = {{ fg = "{t["text"]}" }}
hovered = {{ fg = "{t["pink"]}", bold = true }}

[help]
border  = {{ fg = "{t["accent"]}" }}
chord   = {{ fg = "{t["accent"]}" }}
action  = {{ fg = "{t["text"]}" }}
hovered = {{ fg = "{t["base"]}", bg = "{t["accent"]}", bold = true }}

[filetype]
rules = [
	{{ mime = "**/image/*", fg = "{t["yellow"]}" }},
	{{ mime = "**/{{audio,video}}/*", fg = "{t["pink"]}" }},
	{{ mime = "**/application/{{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}}", fg = "{t["red"]}" }},
	{{ mime = "**/application/{{pdf,doc,rtf}}", fg = "{t["orange"]}" }},
	{{ mime = "vfs/{{absent,stale}}", fg = "{t["gray"]}" }},
	{{ url = "*", is = "orphan", bg = "{t["red"]}" }},
	{{ url = "*", is = "exec", fg = "{t["green"]}" }},
	{{ url = "*", is = "dummy", bg = "{t["red"]}" }},
	{{ url = "*/", is = "dummy", bg = "{t["red"]}" }},
	{{ url = "*/", fg = "{t["accent"]}" }},
]
"""


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--wallpapers", action="store_true",
                    help="also regenerate the palette-derived wallpapers (~3s)")
    args = ap.parse_args()

    try:
        with open(THEME) as f:
            t = json.load(f)
    except (OSError, ValueError) as e:
        sys.exit(f"cannot read {THEME}: {e}")

    targets = [
        (os.path.join(DOTS, "hypr", "colors.conf"), hyprland(t)),
        (os.path.join(DOTS, "hypr", "colors.lua"), hyprland_lua(t)),
        (os.path.join(DOTS, "hypr", "hyprlock-colors.conf"), hyprlock(t)),
        (os.path.join(DOTS, "ghostty", "colors"), ghostty(t)),
        (os.path.join(DOTS, "dolphin", "kdeglobals"), kdeglobals(t)),
        (os.path.join(DOTS, "yazi", "theme.toml"), yazi(t)),
        (os.path.join(DOTS, "quickshell-greeter", "Colors.qml"), greeter_palette(t)),
    ]

    changed = [os.path.basename(p) for p, c in targets if write(p, c)]

    if changed:
        print("updated: " + ", ".join(changed))
        subprocess.run(["hyprctl", "reload"], capture_output=True)
    else:
        print("already up to date")

    if args.wallpapers:
        subprocess.run([os.path.join(DOTS, "quickshell", "scripts", "wallgen")], check=False)

    print(f"theme: {t.get('name', 'unnamed')}")
    print("ghostty needs a restart to pick up colour changes")


if __name__ == "__main__":
    main()
