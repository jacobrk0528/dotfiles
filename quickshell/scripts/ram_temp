#!/bin/bash

# DDR5 DIMM temperatures from the spd5118 hwmon sensors (one per stick).
# The card shows the hottest stick; the tooltip lists each one.

max_val=""
dimm_lines=""

for h in /sys/class/hwmon/hwmon*; do
  [ "$(cat "$h/name" 2>/dev/null)" = "spd5118" ] || continue
  raw=$(cat "$h/temp1_input" 2>/dev/null) || continue
  c_val=$(awk "BEGIN {printf \"%.1f\", $raw/1000}")
  # Device name is like 6-0051: the SPD address identifies the slot
  addr=$(basename "$(readlink -f "$h/device")")
  dimm_lines="${dimm_lines}\n  DIMM ${addr##*-}:  ${c_val}°C"
  if [ -z "$max_val" ] || awk "BEGIN {exit !($c_val > $max_val)}"; then
    max_val="$c_val"
  fi
done

if [ -z "$max_val" ]; then
  jq -c -n '{text: "N/A", tooltip: "No spd5118 sensors found (modprobe spd5118)"}'
  exit 0
fi

max_int=${max_val%.*}

# DDR5 is rated to ~85°C, but errors at EXPO speeds start climbing past ~60°C
if [ "$max_int" -lt 55 ]; then
  temp_color="<span color=\"#50fa7b\">${max_val}°C</span>"
elif [ "$max_int" -lt 70 ]; then
  temp_color="<span color=\"#f1fa8c\">${max_val}°C (Warm)</span>"
else
  temp_color="<span color=\"#ff5555\">${max_val}°C (HOT)</span>"
fi

tooltip=$(printf "Memory Temperatures\n\n  Hottest: %b\n%b\n\nStable under ~60°C at EXPO speeds; rated to 85°C" "$temp_color" "$dimm_lines")
text="$(awk "BEGIN {printf \"%.0f\", $max_val}")°C"

jq -c -n --arg text "$text" --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip}'
