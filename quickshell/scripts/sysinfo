#!/usr/bin/env python3
"""One-shot system snapshot as JSON, polled by the shell's SysInfo service.

Consolidates what used to be several separate waybar scripts into a single
process so the desktop widgets can poll cheaply.
"""

import json
import os
import re
import shutil
import socket
import subprocess
import sys

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "quickshell_sysinfo.state")


def cpu_usage():
    """Percentage since the previous call, using a small state file."""
    with open("/proc/stat") as f:
        fields = [int(x) for x in f.readline().split()[1:]]
    idle, total = fields[3] + fields[4], sum(fields)

    prev = None
    try:
        with open(STATE) as f:
            prev = [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        pass

    try:
        with open(STATE, "w") as f:
            f.write(f"{total} {idle}")
    except OSError:
        pass

    if not prev or len(prev) != 2:
        return 0.0
    d_total, d_idle = total - prev[0], idle - prev[1]
    if d_total <= 0:
        return 0.0
    return round(100 * (1 - d_idle / d_total), 1)


def memory():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, _, v = line.partition(":")
            info[k] = int(v.split()[0])
    total = info["MemTotal"] / 1048576
    avail = info["MemAvailable"] / 1048576
    used = total - avail
    return {
        "used": round(used, 1),
        "total": round(total, 1),
        "pct": round(100 * used / total, 1) if total else 0,
    }


def cpu_temp():
    for hwmon in sorted(os.listdir("/sys/class/hwmon")):
        base = f"/sys/class/hwmon/{hwmon}"
        try:
            name = open(f"{base}/name").read().strip()
        except OSError:
            continue
        if name not in ("k10temp", "coretemp"):
            continue
        for entry in sorted(os.listdir(base)):
            if not entry.endswith("_label"):
                continue
            label = open(f"{base}/{entry}").read().strip()
            if label in ("Tctl", "Package id 0"):
                raw = open(f"{base}/{entry[:-6]}_input").read().strip()
                return round(int(raw) / 1000, 1)
    return None


def disk():
    st = os.statvfs("/")
    total = st.f_blocks * st.f_frsize / 1e9
    free = st.f_bavail * st.f_frsize / 1e9
    used = total - free
    return {
        "used": round(used, 1),
        "total": round(total, 1),
        "pct": round(100 * used / total, 1) if total else 0,
    }


def gpu():
    if not shutil.which("nvidia-smi"):
        return None
    query = "name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw"
    try:
        out = subprocess.run(
            ["nvidia-smi", f"--query-gpu={query}", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3,
        ).stdout.strip().splitlines()
    except (subprocess.SubprocessError, OSError):
        return None
    if not out:
        return None

    parts = [p.strip() for p in out[0].split(",")]
    if len(parts) < 6:
        return None

    def num(x):
        try:
            return float(x)
        except ValueError:
            return 0.0

    vram_used, vram_total = num(parts[3]), num(parts[4])
    return {
        "name": parts[0],
        "temp": num(parts[1]),
        "util": num(parts[2]),
        "vramUsed": round(vram_used / 1024, 1),
        "vramTotal": round(vram_total / 1024, 1),
        "vramPct": round(100 * vram_used / vram_total, 1) if vram_total else 0,
        "power": num(parts[5]),
    }


def uptime():
    with open("/proc/uptime") as f:
        secs = int(float(f.read().split()[0]))
    days, rem = divmod(secs, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {mins}m"
    return f"{mins}m"


def main():
    data = {
        "cpu": {"usage": cpu_usage(), "temp": cpu_temp()},
        "mem": memory(),
        "disk": disk(),
        "gpu": gpu(),
        "uptime": uptime(),
        "host": socket.gethostname(),
        "user": os.environ.get("USER", ""),
    }
    json.dump(data, sys.stdout)


if __name__ == "__main__":
    main()
