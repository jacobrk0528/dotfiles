#!/bin/bash

# CPU usage
cpu=$(top -bn1 | grep "Cpu(s)" | awk '{print int($2)}')

# RAM used / total
mem_used=$(free -m | awk '/^Mem:/ {printf "%.1f", $3/1024}')
mem_total=$(free -m | awk '/^Mem:/ {printf "%.0f", $2/1024}')

# CPU temp (k10temp)
cpu_temp=$(cat /sys/class/hwmon/hwmon1/temp1_input 2>/dev/null | awk '{printf "%.0f", $1/1000}')

# GPU temp (nvidia-smi)
gpu_temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null)

# Audio volume
vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%.0f", $2*100}')
muted=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -c MUTED)

# Build bar text: icons only
if [ "$muted" -gt 0 ]; then
  vol_icon=""
else
  if [ "$vol" -lt 30 ]; then vol_icon=""
  elif [ "$vol" -lt 70 ]; then vol_icon=""
  else vol_icon=""
  fi
fi

text=""

# Build tooltip: full detail
tooltip="CPU: ${cpu}%\nRAM: ${mem_used} / ${mem_total} GiB\nCPU temp: ${cpu_temp}°C\nGPU temp: ${gpu_temp}°C\nVolume: ${vol}%"

# Determine class for critical states
class="default"
if [ "${cpu_temp:-0}" -ge 80 ] || [ "${gpu_temp:-0}" -ge 80 ]; then
  class="critical"
fi

printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' \
  "$text" "$tooltip" "$class"
