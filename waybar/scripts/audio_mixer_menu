#!/usr/bin/env bash

MENU_CMD=""
if command -v rofi >/dev/null 2>&1; then
  MENU_CMD="rofi -dmenu -i -p"
elif command -v wofi >/dev/null 2>&1; then
  MENU_CMD="wofi --dmenu --insensitive --prompt"
fi

[ -z "$MENU_CMD" ] && { pavucontrol & exit 0; }

# Parse sink inputs (active app streams)
declare -A app_names
declare -A app_vols
declare -A app_mutes
declare -A app_pids

current_id=""
while IFS= read -r line; do
  if [[ "$line" =~ ^Sink\ Input\ #([0-9]+) ]]; then
    current_id="${BASH_REMATCH[1]}"
  elif [ -n "$current_id" ]; then
    if [[ "$line" =~ Volume:\ .*/\ *([0-9]+)% ]]; then
      app_vols["$current_id"]="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ Mute:\ *(yes|no) ]]; then
      app_mutes["$current_id"]="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ application.name\ =\ \"(.*)\" ]]; then
      app_names["$current_id"]="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ application.process.id\ =\ \"(.*)\" ]]; then
      app_pids["$current_id"]="${BASH_REMATCH[1]}"
    fi
  fi
done < <(pactl list sink-inputs 2>/dev/null)

# Count duplicate app names to add #1, #2 tags
declare -A app_counts
declare -A app_indices

for id in "${!app_names[@]}"; do
  name="${app_names[$id]}"
  app_counts["$name"]=$(( ${app_counts["$name"]:-0} + 1 ))
done

# Build main menu options
menu_items=()
menu_items+=("⚙ Open Full Mixer (Pavucontrol)")
menu_items+=("🔊 Master Volume")

declare -A id_map
index=2

# Sort IDs numerically for consistent ordering
sorted_ids=$(echo "${!app_names[*]}" | tr ' ' '\n' | sort -n)

for id in $sorted_ids; do
  [ -z "$id" ] && continue
  name="${app_names[$id]}"
  vol="${app_vols[$id]:-100}"
  mute="${app_mutes[$id]:-no}"

  count=${app_counts["$name"]}
  tag=""
  if [ "$count" -gt 1 ]; then
    app_indices["$name"]=$(( ${app_indices["$name"]:-0} + 1 ))
    tag=" #${app_indices["$name"]}"
  fi

  icon="🎵"
  [ "$mute" = "yes" ] && icon="🔇"

  item_label="${icon} ${name}${tag} [${vol}%]"
  menu_items+=("$item_label")
  id_map["$index"]="$id"
  ((index++))
done

# Run main menu
selected=$(printf "%s\n" "${menu_items[@]}" | $MENU_CMD "Audio Mixer")
[ -z "$selected" ] && exit 0

if [[ "$selected" == *"Pavucontrol"* ]]; then
  pavucontrol &
  exit 0
elif [[ "$selected" == *"Master Volume"* ]]; then
  target_id="master"
  target_label="Master Volume"
else
  target_id=""
  for idx in "${!menu_items[@]}"; do
    if [ "${menu_items[$idx]}" = "$selected" ]; then
      target_id="${id_map[$idx]}"
      target_label="${selected}"
      break
    fi
  done
fi

[ -z "$target_id" ] && exit 0

# Submenu for volume adjustments
sub_options=(
  "🔊 100%"
  "🔉 90%"
  "🔉 80%"
  "🔉 70%"
  "🔉 60%"
  "🔈 50%"
  "🔈 30%"
  "🔈 10%"
  "🔇 Toggle Mute"
  "➕ +10%"
  "➖ -10%"
)

sub_selected=$(printf "%s\n" "${sub_options[@]}" | $MENU_CMD "$target_label")
[ -z "$sub_selected" ] && exit 0

if [ "$target_id" = "master" ]; then
  case "$sub_selected" in
    "🔊 100%") pactl set-sink-volume @DEFAULT_SINK@ 100% ;;
    "🔉 90%")  pactl set-sink-volume @DEFAULT_SINK@ 90% ;;
    "🔉 80%")  pactl set-sink-volume @DEFAULT_SINK@ 80% ;;
    "🔉 70%")  pactl set-sink-volume @DEFAULT_SINK@ 70% ;;
    "🔉 60%")  pactl set-sink-volume @DEFAULT_SINK@ 60% ;;
    "🔈 50%")  pactl set-sink-volume @DEFAULT_SINK@ 50% ;;
    "🔈 30%")  pactl set-sink-volume @DEFAULT_SINK@ 30% ;;
    "🔈 10%")  pactl set-sink-volume @DEFAULT_SINK@ 10% ;;
    "🔇 Toggle Mute") pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    "➕ +10%") pactl set-sink-volume @DEFAULT_SINK@ +10% ;;
    "➖ -10%") pactl set-sink-volume @DEFAULT_SINK@ -10% ;;
  esac
else
  case "$sub_selected" in
    "🔊 100%") pactl set-sink-input-volume "$target_id" 100% ;;
    "🔉 90%")  pactl set-sink-input-volume "$target_id" 90% ;;
    "🔉 80%")  pactl set-sink-input-volume "$target_id" 80% ;;
    "🔉 70%")  pactl set-sink-input-volume "$target_id" 70% ;;
    "🔉 60%")  pactl set-sink-input-volume "$target_id" 60% ;;
    "🔈 50%")  pactl set-sink-input-volume "$target_id" 50% ;;
    "🔈 30%")  pactl set-sink-input-volume "$target_id" 30% ;;
    "🔈 10%")  pactl set-sink-input-volume "$target_id" 10% ;;
    "🔇 Toggle Mute") pactl set-sink-input-mute "$target_id" toggle ;;
    "➕ +10%") pactl set-sink-input-volume "$target_id" +10% ;;
    "➖ -10%") pactl set-sink-input-volume "$target_id" -10% ;;
  esac
fi
