{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 12,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/ai_sessions", "custom/stats", "pulseaudio", "battery"],

  "clock": {
    "interval": 1,
    "format": "{:%a %b %d  %H:%M:%S}",
    "tooltip-format": "{:%A, %B %d %Y  %H:%M:%S}"
  },

  "window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1",
    "disable-scroll": false
  },

  "custom/stats": {
    "format": "sys",
    "exec": "/home/jkrebs/.config/waybar/scripts/stats",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "custom/ai_sessions": {
    "format": "{}",
    "exec": "/home/jkrebs/dotfiles/waybar/scripts/ai_status",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "chg {capacity}%",
    "format-plugged": "{capacity}%",
    "format-alt": "{time}",
    "format-icons": ["▁", "▂", "▄", "▆", "█"],
    "hide-if-unavailable": true
  }
}
