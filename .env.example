# Single source of secrets/config for everything in ~/dotfiles.
# KEY=value, one per line. Values are taken literally -- never shell-expanded -- by
# scripts/dotenv.sh (bash), systemd EnvironmentFile= and artoo. Real env vars win.

# Home Assistant -- quickshell/scripts/ha-lights*
HA_URL=http://192.168.1.109:8123
HA_TOKEN=

# Gemini -- transcript cleanup in hypr/scripts/ptt-dictate
GEMINI_API_KEY=

# NetSuite ODBC -- scripts/ns_export/nsq.sh (same creds as narsil's .env)
NETSUITE_DSN=Netsuite
NETSUITE_USERNAME=
NETSUITE_PASSWORD=

# artoo (SUPER+A desktop agent) -- TypeSafe Jev picks, OpenAI plans/answers
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PLANNER_MODEL=gpt-5.6-sol

# Cloudflare API (zone jkrebs.net: tunnel, DNS, Access) -- used by Claude for homelab changes
CLOUDFLARE_API_TOKEN=

# Kasa / TP-Link account (Home Assistant tplink integration)
KASA_USERNAME=
KASA_PASSWORD=
INTELEPHENSE_LICENSE_KEY=
