[Unit]
Description=Notify on runaway processes (CPU, memory, GPU, disk, temperatures)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/python3 %h/dotfiles/hypr/scripts/proc-watch/proc-watch.py
Restart=always
RestartSec=5
# It's a watchdog, not the thing being watched: stay out of the way
Nice=10

[Install]
WantedBy=graphical-session.target
