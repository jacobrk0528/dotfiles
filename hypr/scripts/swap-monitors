#!/usr/bin/env bash
# SUPER+CTRL+M. Swaps which physical screen is Left and which is Right.
#
# The two side monitors are the same Sceptre model with identical EDID, so
# nothing can detect which is physically which -- the choice is just remembered.
# This toggles that memory and re-applies; the setting persists across reboots.
#
# Previously this sed-swapped the connector names DP-7/DP-8 in hyprland.lua.
# The config no longer hardcodes connectors at all, so there is nothing to sed.
exec "$(dirname "$(readlink -f "$0")")/side-monitors" --flip
