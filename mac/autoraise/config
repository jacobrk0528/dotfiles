#AutoRaise config file
# Linked to ~/.config/AutoRaise/config by scripts/link.sh.
# Apply changes with: brew services restart autoraise
# Comments go on their own lines; values are read verbatim.

# Check the mouse position every 50ms
pollMillis=50
# Raise + focus after 1 poll once the mouse settles
delay=1
# Don't flip focus while the mouse is still sweeping across windows
requireMouseStop=true
# Don't grab focus right after switching Spaces
ignoreSpaceChanged=true
# Don't enlarge the cursor after a warp (warps only happen on cmd-tab)
scale=1.0
# Hold ctrl while moving to leave focus where it is (menu bar, dock, etc.)
disableKey=control
