{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Control -> Command, except inside terminal apps (keeps real Ctrl for SIGINT/readline/tmux/vim, incl. over SSH)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^com\\.googlecode\\.iterm2$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^io\\.alacritty$",
                                            "^org\\.alacritty$",
                                            "^dev\\.warp\\.Warp-Stable$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
